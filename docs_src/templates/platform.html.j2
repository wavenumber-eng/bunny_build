<section class="reference-heading">
  <h1>Platform Guide</h1>
  <p>Generated from pinned MCUXpresso SDK feature and COMMON headers. This page lists SDK-confirmed SmartDMA/EZH part/core views now; pin mux, INPUTMUX trigger maps, and wrapper setup remain pending enrichment.</p>
  <div class="status-strip" aria-label="Platform discovery status">
    <div class="stat">
      <span class="stat-label">Confirmed Parts</span>
      <span class="stat-value">{{ platform.summary.confirmed_parts }}</span>
    </div>
    <div class="stat">
      <span class="stat-label">Core Views</span>
      <span class="stat-value">{{ platform.summary.confirmed_core_views }}</span>
    </div>
    <div class="stat">
      <span class="stat-label">Missing IRQs</span>
      <span class="stat-value">{{ platform.summary.cores_missing_irq }}</span>
    </div>
    <div class="stat">
      <span class="stat-label">Missing Bases</span>
      <span class="stat-value">{{ platform.summary.missing_base_core_views }}</span>
    </div>
  </div>
</section>

<article class="prose platform-guide">
  <h2>Source Boundary</h2>
  <p>The committed data comes from <code>isa/ezh_b/platform/</code>, generated by <code>isa/tools/discover_parts.py</code> from manifest <code>{{ platform.manifest_revision_short }}</code>. A row is a core view: dual-core parts can appear twice because SDK headers expose per-core facts separately.</p>
  <p>Presence is confirmed only by SDK feature probes such as <code>FSL_FEATURE_SOC_SMARTDMA_COUNT</code>. Unconfirmed LPC markers are listed separately and are not promoted to platform rows.</p>

  <h2>Series Coverage</h2>
  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th>Series</th>
          <th>Feature Headers Scanned</th>
          <th>Confirmed Parts</th>
          <th>Confirmed Core Views</th>
          <th>Broad EZH Scan</th>
        </tr>
      </thead>
      <tbody>
        {% for row in platform.series %}
        <tr>
          <td><code>{{ row.series }}</code></td>
          <td>{{ row.feature_headers_scanned }}</td>
          <td>{{ row.confirmed_parts }}</td>
          <td>{{ row.confirmed_core_views }}</td>
          <td>{{ row.broad_ezh_files_scanned }} files, {{ row.broad_ezh_candidates }} candidates</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <h2>Family Coverage</h2>
  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th>Series</th>
          <th>Family</th>
          <th>Parts</th>
          <th>Core Views</th>
        </tr>
      </thead>
      <tbody>
        {% for row in platform.families %}
        <tr>
          <td><code>{{ row.series }}</code></td>
          <td><code>{{ row.family }}</code></td>
          <td>{{ row.parts }}</td>
          <td>{{ row.core_views }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <h2>Confirmed SDK Header Matches</h2>
  <p>Base-address cells show the macro and address exactly as extracted from the matching COMMON header. Empty base-address cells are extraction gaps, not proof that the part lacks the block.</p>
  <div class="table-scroll">
    <table class="platform-table">
      <thead>
        <tr>
          <th>Part</th>
          <th>Core</th>
          <th>Probe</th>
          <th>IRQ</th>
          <th>Base Addresses</th>
        </tr>
      </thead>
      <tbody>
        {% for row in platform.core_rows %}
        <tr>
          <td><a href="#{{ row.anchor }}"><code>{{ row.part }}</code></a><br><span class="small-note">{{ row.series }} / {{ row.family }}</span></td>
          <td><code>{{ row.core }}</code></td>
          <td><code>{{ row.presence.probe }}</code> = {{ row.presence.count }}</td>
          <td>
            {% if row.irqs %}
            <ul class="compact-list">
              {% for irq in row.irqs %}
              <li><code>{{ irq.label }}</code>{% if irq.description %}<br><span class="small-note">{{ irq.description }}</span>{% endif %}</li>
              {% endfor %}
            </ul>
            {% else %}
            <span class="badge warn">missing</span>
            {% endif %}
          </td>
          <td>
            {% if row.base_addresses %}
            <ul class="compact-list">
              {% for base in row.base_addresses %}
              <li><code>{{ base.label }}</code><br><span class="small-note">{{ base.space }}</span></li>
              {% endfor %}
            </ul>
            {% else %}
            <span class="badge warn">missing</span>
            {% endif %}
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <h2>Open Extraction Gaps</h2>
  {% if platform.open_items %}
  <ul>
    {% for item in platform.open_items %}
    <li><code>{{ item.id }}</code>: {{ item.detail }}</li>
    {% endfor %}
  </ul>
  {% else %}
  <p>No open extraction gaps are recorded.</p>
  {% endif %}

  {% if platform.unconfirmed_candidates %}
  <h3 id="unconfirmed-lpc-candidates">Unconfirmed LPC Candidates</h3>
  <p>These files mention EZH in the broader LPC sweep, but they do not include a feature-header presence probe. They need AN/RM or nxp-monkey confirmation before they become platform rows.</p>
  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th>Series</th>
          <th>Path</th>
          <th>Reason</th>
          <th>Visible IRQ/Base Facts</th>
        </tr>
      </thead>
      <tbody>
        {% for item in platform.unconfirmed_candidates %}
        <tr>
          <td><code>{{ item.series }}</code></td>
          <td><code>{{ item.path }}</code></td>
          <td>{{ item.reason }}</td>
          <td>
            {% if item.irqs or item.base_addresses %}
            <ul class="compact-list">
              {% for irq in item.irqs %}
              <li><code>{{ irq.label }}</code>{% if irq.description %}<br><span class="small-note">{{ irq.description }}</span>{% endif %}</li>
              {% endfor %}
              {% for base in item.base_addresses %}
              <li><code>{{ base.label }}</code><br><span class="small-note">{{ base.space }}</span></li>
              {% endfor %}
            </ul>
            {% else %}
            <span class="small-note">none extracted</span>
            {% endif %}
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}

  <h2>Per-Part Details</h2>
  <section class="opcode-list" aria-label="Per-part platform details">
    {% for part in platform.parts %}
    <details class="opcode-panel" id="{{ part.anchor }}">
      <summary class="opcode-summary">
        <span class="opcode-title">
          <span class="opcode-name">{{ part.part }}</span>
          <span class="opcode-meta">{{ part.series }} / {{ part.family }}</span>
        </span>
        <span class="badge-row">
          <span class="badge">{{ part.cores | length }} core{% if part.cores | length != 1 %}s{% endif %}</span>
          <span class="badge public">SDK feature confirmed</span>
        </span>
      </summary>
      <div class="opcode-body">
        <p><span class="small-note">Repo:</span> <code>{{ part.repo_path }}</code> at <code>{{ part.repo_revision_short }}</code></p>
        <p><span class="small-note">Pending enrichment:</span> pin mux, INPUTMUX trigger maps, and register-block wrapper details.</p>
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th>Core</th>
                <th>Feature Header</th>
                <th>COMMON Header</th>
              </tr>
            </thead>
            <tbody>
              {% for core in part.cores %}
              <tr>
                <td><code>{{ core.core }}</code></td>
                <td><code>{{ core.features_header }}</code></td>
                <td>{% if core.common_header %}<code>{{ core.common_header }}</code>{% else %}<span class="small-note">missing</span>{% endif %}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </details>
    {% endfor %}
  </section>

  <section class="provenance-block" aria-label="Platform discovery notes">
    <h2>Discovery Notes</h2>
    <ul>
      {% for note in platform.notes %}
      <li>{{ note }}</li>
      {% endfor %}
    </ul>
  </section>
</article>
